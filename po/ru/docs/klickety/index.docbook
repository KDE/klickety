<sect1 id="default-keybindings">
<title id="keybindings-title"
>Комбинации клавиш по умолчанию</title>
<para
>Комбинации клавиш по умолчанию:</para>

<table>
<title
>Комбинации клавиш</title>
<tgroup cols="2">
<tbody>
<row>
<entry
>Начать игру</entry>
<entry
><keycombo action="simul"
>&Ctrl;<keycap
>N</keycap
></keycombo
></entry>
</row>
<row>
<entry
>Загрузить</entry>
<entry
><keycombo action="simul"
>&Ctrl;<keycap
>O</keycap
></keycombo
></entry>
</row>
<row>
<entry
>Начать заново</entry>
<entry
><keycap
>F5</keycap
></entry>
</row>
<row>
<entry
>Сохранить</entry>
<entry
><keycombo action="simul"
>&Ctrl;<keycap
>S</keycap
></keycombo
></entry>
</row>
<row>
<entry
>Пауза</entry>
<entry
><keycap
>P</keycap
></entry>
</row>
<row>
<entry
>Показать лучшие результаты</entry>
<entry
><keycombo action="simul"
>&Ctrl;<keycap
>H</keycap
></keycombo
></entry>
</row>
<row>
<entry
>Выход</entry>
<entry
><keycombo action="simul"
>&Ctrl;<keycap
>Q</keycap
></keycombo
></entry>
</row>
<row>
<entry
